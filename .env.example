# ===== 复制本文件为 .env 并填入真实值；.env 已被 gitignore，严禁提交 =====

# 本地应用端口（后端和 Vite 代理共用；避开 Windows 保留端口）
SERVER_PORT=18080
FRONTEND_BASE_URL=http://localhost:5173

# DeepSeek 对话模型
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云通义（DashScope）embedding
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# PostgreSQL（本地开发）
POSTGRES_DB=techstack
POSTGRES_USER=techstack
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_PASSWORD=change_me_dev_password

# GitHub（应用级 Token，可选，仅搜公开仓库）
GITHUB_TOKEN=your_github_token_here

# GitHub OAuth App（登录用）
# 本地 callback URL: http://localhost:18080/login/oauth2/code/github
GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# 用户 Token 加密密钥（至少 32 个随机字符；禁止示例值）
TOKEN_CIPHER_KEY=
# 密钥轮换兼容窗口：旧密钥用逗号分隔；不轮换时留空
TOKEN_CIPHER_PREVIOUS_KEYS=

# Tavily 联网搜索（M6 Agent 的 web 搜索工具，https://tavily.com 免费注册）
TAVILY_SEARCH_API_KEY=your_tavily_api_key_here
