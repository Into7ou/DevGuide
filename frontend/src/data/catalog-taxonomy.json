{
  "version": 1,
  "directions": [
    {
      "id": "frontend",
      "name": "前端开发",
      "short": "前端",
      "icon": "window",
      "intro": "构建界面，让每一次交互自然发生。",
      "groups": ["ui", "build"]
    },
    {
      "id": "backend",
      "name": "后端开发",
      "short": "后端",
      "icon": "server",
      "intro": "从接口到数据，让应用可靠运行。",
      "groups": ["languages", "frameworks", "storage", "cache", "queues"]
    },
    {
      "id": "ai",
      "name": "人工智能",
      "short": "智能",
      "icon": "spark",
      "intro": "从模型到应用，让想法拥有新的可能。",
      "groups": ["models", "agents"]
    },
    {
      "id": "data",
      "name": "数据处理",
      "short": "数据",
      "icon": "database",
      "intro": "整理、分析与计算，让数据产生价值。",
      "groups": ["analysis", "distributed", "streams"]
    },
    {
      "id": "ops",
      "name": "部署运维",
      "short": "运维",
      "icon": "layers",
      "intro": "让应用顺利上线，也让系统持续稳定。",
      "groups": ["containers", "delivery"]
    }
  ],
  "groups": {
    "ui": { "name": "界面框架", "desc": "构建 Web 与跨平台交互界面", "icon": "window" },
    "build": { "name": "构建工具", "desc": "组织代码、模块与开发流程", "icon": "layers" },
    "languages": { "name": "通用编程语言", "desc": "学习服务端与通用软件开发语言", "icon": "code" },
    "frameworks": { "name": "开发框架", "desc": "构建服务端应用与接口", "icon": "code" },
    "storage": { "name": "数据存储", "desc": "保存与查询业务数据", "icon": "database" },
    "cache": { "name": "缓存服务", "desc": "加速高频数据访问", "icon": "bolt" },
    "queues": { "name": "消息队列", "desc": "连接服务与异步任务", "icon": "nodes" },
    "models": { "name": "模型开发", "desc": "构建与训练学习模型", "icon": "spark" },
    "agents": { "name": "智能应用", "desc": "将模型接入实际任务", "icon": "nodes" },
