# Production template. Copy to a protected host path; never commit real values.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=18080
FRONTEND_BASE_URL=https://devguide.into7ou.is-a.dev
SITE_ADDRESS=devguide.into7ou.is-a.dev
IMAGE_TAG=v0.7.0

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
TAVILY_SEARCH_API_KEY=

# 生产生成成本保护；开发环境默认关闭。
GENERATION_AGENT_DAILY_LIMIT=10
GENERATION_DISCOVERY_DAILY_LIMIT=20
GENERATION_MAX_CONCURRENT=2

POSTGRES_DB=techstack
POSTGRES_USER=techstack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=

GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Generate at least 32 random characters. During rotation, move the old key to
# TOKEN_CIPHER_PREVIOUS_KEYS until all users have signed in again.
TOKEN_CIPHER_KEY=
TOKEN_CIPHER_PREVIOUS_KEYS=
